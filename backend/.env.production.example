NODE_ENV="production"
PORT="4000"
PUBLIC_API_URL="https://api.example.com"
FRONTEND_URL="https://example.com"
CORS_ORIGINS="https://example.com"
TRUST_PROXY="1"
UPLOAD_DIR="uploads"

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="akif_poliklinik"
DB_PASSWORD="replace-with-a-strong-password"
DB_NAME="akif_poliklinik"
DB_CONNECTION_LIMIT="10"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

MAIL_ENABLED="true"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM_NAME="Akif Poliklinik"
SMTP_FROM_ADDRESS="info@example.com"
CONTACT_NOTIFICATION_TO="info@example.com"
PASSWORD_RESET_TO="admin@example.com"
PASSWORD_RESET_EXPIRES_MINUTES="30"

ADMIN_FULL_NAME="Akif Poliklinik Yöneticisi"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-production-password"
